# Copy to .env.local (git-ignored) and fill in. Only VITE_* values ship to the browser (NFR-SEC-02).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# Test and tooling only. NEVER prefix with VITE_, never commit, never paste into CI logs.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>   # RLS two-user test creates/deletes test users
SUPABASE_DB_URL=<Dashboard -> Connect -> Session pooler URI, with the DB password>   # pnpm db:push
