{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "e2e",
    "supabase/tests",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.ts",
    "spikes/**/*.ts"
  ]
}
